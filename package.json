{
  "name": "blind-oracle",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:publish-request && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "gh workflow run deploy.yml --repo systemslibrarian/crypto-lab-blind-oracle --ref main",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "dependencies": {
    "tfhe": "^1.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "coi-serviceworker": "^0.1.7",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
